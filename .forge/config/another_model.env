# ==============================================================================
# FORGELOOP — VARIÁVEIS DE CONTROLE DE MODELOS E SKILLS
# Edite este arquivo para trocar ou testar modelos sem alterar o código Go.
# ==============================================================================

# AUTENTICAÇÃO E FALLBACK OMNIROUTE
#FORGE_AUTH_MODE="api_key"
FORGE_AUTH_MODE="another"
FORGE_OMNIROUTE_ENABLED="false"
FORGE_OMNIROUTE_URL="http://localhost:20128"
FORGE_OMNIROUTE_MODEL="claude-sonnet-4-6"

# ETAPA 0 — DISCOVERY (Onboarding de projetos já existentes)
FORGE_ONBOARDER_BIN=claude
FORGE_ONBOARDER_MODEL=opus
# Argumentos extras do CLI (opcional, separados por espaço). Necessários para o modo headless (-p)
# conseguir gravar arquivos / rodar testes sem bloquear em prompt de permissão.
FORGE_ONBOARDER_ARGS=--permission-mode acceptEdits

# ETAPA 1 — BLUEPRINT (Planejamento incremental + criação de testes RED)
FORGE_ARCHITECT_BIN=claude
FORGE_ARCHITECT_MODEL=opus
FORGE_ARCHITECT_SKILL=obra/superpowers
# ATENÇÃO: --dangerously-skip-permissions desativa TODOS os prompts de permissão do Claude Code.
# Use apenas em repositório confiável / ambiente isolado.
FORGE_ARCHITECT_ARGS=--dangerously-skip-permissions

# ETAPA 2 — TEMPER (Revisão crítica a frio + invariantes globais)
FORGE_SKEPTIC_BIN=agy
FORGE_SKEPTIC_MODEL=Gemini 3.8 Flash (High)
FORGE_SKEPTIC_SKILL=google/elephant-goldfish-model
FORGE_SKEPTIC_ARGS=--yolo

# ETAPA 3 — STRIKE (Execução rápida em contexto higienizado)
FORGE_BUILDER_BIN=claude
FORGE_BUILDER_MODEL=sonnet
FORGE_BUILDER_ARGS=--dangerously-skip-permissions

# ETAPA 4B — QUENCH APPSEC (Auditoria de segurança no git diff)
FORGE_SENTINEL_BIN=agy
FORGE_SENTINEL_MODEL=Gemini 3.8 Flash (Medium)
FORGE_SENTINEL_SKILL=cloudflare/security-audit-skill
FORGE_SENTINEL_ARGS=--dangerously-skip-permissions

# ETAPA 5 — ASSAY (Juiz semântico final + Circuit Breaker)
FORGE_ARBITER_BIN=agy
FORGE_ARBITER_MODEL=Gemini 3.8 Flash (High)
FORGE_ARBITER_ARGS=--dangerously-skip-permissions

# As variáveis FORGE_*_SKILL usam o identificador completo "dono/repositório": `./forgeloop -init` instala as ausentes (npx skills add <skill> -g -y).

# CONTROLE DO LOOP & DOCUMENTAÇÃO
FORGE_MAX_ATTEMPTS=3
FORGE_DEFAULT_DOCS_DIR=docs

